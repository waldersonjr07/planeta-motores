# Certificado emitido e renovado sozinho, sem intervenção.
{$DOMINIO} {
	encode gzip
	reverse_proxy app:3000

	header {
		# Proteção contra Clickjacking
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none';"
		# Proteção contra MIME-sniffing
		X-Content-Type-Options "nosniff"
		# Previne vazamento de URLs internas no Referer
		Referrer-Policy "strict-origin-when-cross-origin"
		# HSTS (Força HTTPS em navegadores clientes)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Desabilita APIs desnecessárias de sensores
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Fotos e PDFs já são servidos por rota autenticada da aplicação; nada aqui
	# deve ser cacheado por intermediário.
	header /api/* Cache-Control "private, no-store"

	log {
		output file /data/acesso.log
		format json
	}
}
